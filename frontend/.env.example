# ============================================================
# Mindful Flutter App - .env.example
# Copy this file to '.env' and fill in your keys.
# ============================================================

# ── Supabase Credentials ────────────────────────────────────
# Get these from the Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Gemini AI ───────────────────────────────────────────────
# Get this from Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Backend Connection ──────────────────────────────────────
# LAN/local IP of the backend machine (e.g. 192.168.1.50)
# Required only for testing on physical devices (Android/iOS) over the same Wi-Fi.
# If testing on emulator/simulator, this can be left blank or localhost.
BACKEND_HOST=
