# ============================================================
# .env.example — copy to .env and fill in real values
# .env is gitignored and must NEVER be committed
# ============================================================

# ── Supabase (Flutter) ──────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend: ADHD model paths ───────────────────────────────
# Leave blank to use the default relative paths under backend/Models/adhd/
ADHD_MODELS_DIR=
ADHD_BEHAVIOR_MODEL=
ADHD_BEHAVIOR_FEATURES=
ADHD_EYE_MODEL=
ADHD_VOICE_CNN=
ADHD_VOICE_SVM=
ADHD_VOICE_SCALER=
ADHD_FACIAL_MODEL=

# ── Backend: Depression model paths ─────────────────────────
# Leave blank to use the default relative paths under backend/Models/depression/
DEPRESSION_MODELS_DIR=
DEP_AUDIO_MODEL=
DEP_AUDIO_SCALER=
DEP_VISUAL_MODEL=
DEP_VISUAL_META=
DEP_TEXT_MODEL_DIR=
DEP_FUSION_MODEL=

# ── Backend: Other model paths ───────────────────────────────
ANXIETY_MODEL=
ASD_FACE_MODEL=
ASD_FACE_CLASSES=
ASD_TEXT_ADABOOST=
ASD_TEXT_XGBOOST=
ASD_TEXT_RANDOMFOREST=
